{
  "name": "tide-times",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "vite build",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply tide-times --local",
    "db:migrate:remote": "wrangler d1 migrations apply tide-times --remote",
    "db:seed:local": "tsx src/scripts/seed.ts",
    "db:seed:remote": "tsx src/scripts/seed.ts --remote",
    "ingest:local": "tsx src/scripts/ingestion.ts",
    "ingest:remote": "tsx src/scripts/ingestion.ts --remote"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.15",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.4",
    "@tanstack/react-start": "1.169.7",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^1.0.0-rc.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "suncalc": "^2.1.4",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tanstack/devtools-vite": "0.8.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^1.0.0-rc.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.166.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
